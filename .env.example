# ==============================================================================
# Hybrid RAG Eval — Configuration (.env.example)
# Copy to .env and customize for local Ollama, Google Gemini, or OpenAI.
# Runs 100% offline out-of-the-box with extractive-grounded + local-svd!
# ==============================================================================

# Answer synthesis provider: extractive-grounded | ollama | gemini | openai
RAG_LLM_PROVIDER=extractive-grounded
RAG_LLM_MODEL=extractive-grounded-v1
RAG_LLM_TIMEOUT_SECONDS=30.0

# Dense embedding backend: local-svd | ollama | gemini | openai
RAG_EMBEDDING_PROVIDER=local-svd
RAG_EMBEDDING_MODEL=tfidf-svd-128
RAG_EMBEDDING_DIM=128

# Optional external provider credentials / URLs
RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_GEMINI_API_KEY=
RAG_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
RAG_OPENAI_API_KEY=
RAG_OPENAI_BASE_URL=https://api.openai.com/v1

# Structure-aware recursive chunking
RAG_CHUNK_SIZE=680
RAG_CHUNK_OVERLAP=96

# Hybrid retrieval (BM25 + Dense + RRF + Cross-Signal Reranking)
RAG_RRF_K=60
RAG_TOP_K=5
RAG_CANDIDATE_POOL_SIZE=25
RAG_BM25_K1=1.5
RAG_BM25_B=0.75

# Citation grounding & automatic abstention thresholds
RAG_MIN_CONFIDENCE_THRESHOLD=0.32
RAG_MIN_TERM_COVERAGE=0.22
RAG_MIN_DENSE_SIMILARITY=0.16
RAG_MAX_ANSWER_SENTENCES=4

# Persistence & startup behavior
RAG_INDEX_DIR=data/index
RAG_CORPUS_DIR=data/corpus
RAG_EVAL_REPORT_PATH=eval/latest_report.json
RAG_AUTO_LOAD_CORPUS=true

# FastAPI server
RAG_HOST=0.0.0.0
RAG_PORT=8000
